# Create a Neon PostgreSQL database and paste its connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Optional OAuth providers. Configure callback URL: https://your-domain/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Care Orchestrator AI (OpenRouter). La chiave vive SOLO lato server: mai nel browser, mai nel repository.
OPENROUTER_API_KEY=""
# Modelli del router AI. Sono dipendenze sostituibili, non il cuore del prodotto.
OPENROUTER_MODEL_FAST="openai/gpt-4o-mini"
OPENROUTER_MODEL_REASONING="anthropic/claude-3.5-sonnet"
OPENROUTER_MODEL_ECONOMY="google/gemini-flash-1.5"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Identificativo applicazione mostrato nel dashboard OpenRouter (facoltativo).
OPENROUTER_APP_NAME="Parenthesys"
